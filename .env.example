# My Code Bot - safe environment example
# Never commit real secrets to GitHub.

# Telegram BotFather token is split at the ':' character.
# Example token: 1234567890:AAxxxx...
TELEGRAM_BOT_ID=1234567890
TELEGRAM_BOT_SECRET=AAxxxx...

# Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional
TELEGRAM_WEBHOOK_SECRET=optional_random_string
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-2.5-flash
MAX_HISTORY=12
MAX_OUTPUT_TOKENS=4096
TEMPERATURE=0.25
